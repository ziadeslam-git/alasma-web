# Copy to .env.local for local overrides. Never put a secret in a NEXT_PUBLIC_ variable: it is sent to the browser.

# Origin of the .NET API (no path). Used by Server Components and, in development, by the /api/v1 rewrite.
API_ORIGIN=http://127.0.0.1:5198

# Public canonical origin of the Next.js site (no trailing slash). Used for canonical URLs, Open Graph, JSON-LD, robots.txt and sitemap.xml.
SITE_URL=http://localhost:3000

# Development only. Hostnames (no scheme, no port; `*` = one label) that may load `next dev` assets besides localhost, so a
# phone can open http://<pc-lan-ip>:3000 and the page hydrates. Default when unset: 192.168.*.* (see src/shared/config/dev-allowed-origins.ts).
# DEV_ALLOWED_ORIGINS=192.168.1.8

# Development and e2e only. Output folder of the e2e `next dev` server (playwright.config.ts uses .next-e2e so it never clashes with `pnpm dev`).
# NEXT_DIST_DIR=.next-e2e

# e2e (Playwright). All optional. The real-API run is owner-only: E2E_REAL_API=1 spawns an isolated API (see AGENTS.md, Testing).
# Opt in to the real-API specs. Leave unset for a normal run.
# E2E_REAL_API=
# Internal port where a real-API spec spawns its OWN API. 5198 (the main backend) is always refused.
E2E_API_PORT=5391
# Reuse an API that is already running instead of spawning one. Leave unset unless you started an isolated API yourself.
# E2E_REUSE_API=
# Folder of the sibling backend repo that the specs run with `dotnet run`.
# E2E_API_DIR=../AlAsmaPro
# Isolated test customer used by the real-API specs (the isolated database's own account; set it per command, never commit it).
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
# Folder OUTSIDE the repo for screenshots from the capture specs (Playwright wipes test-results/).
# E2E_CAPTURE_DIR=
# Another web server (a production build on its own port) for the real-API blocks of catalog-polish and shell-pages.
# E2E_POLISH_ORIGIN=
# E2E_SHELL_ORIGIN=
# Label in the file name of the titles JSON that the titles spec writes into E2E_CAPTURE_DIR (default: run).
# E2E_TITLES_LABEL=
# The API database is chosen by ConnectionStrings__Default, set inline per command and never in a file; its database name must end with _FrontendDev.
