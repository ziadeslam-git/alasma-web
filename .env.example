# Copy to .env.local for local overrides. Never put a secret in a NEXT_PUBLIC_ variable: it is sent to the browser.

# Origin of the .NET API (no path). Used by Server Components and, in development, by the /api/v1 rewrite.
API_ORIGIN=http://127.0.0.1:5198

# Public canonical origin of the Next.js site (no trailing slash). Used for canonical URLs, Open Graph, JSON-LD, robots.txt and sitemap.xml.
SITE_URL=http://localhost:3000
